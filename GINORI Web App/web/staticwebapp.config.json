{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/assets/*", "/src/*", "/config.js"]
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  },
  "mimeTypes": {
    ".js": "text/javascript",
    ".css": "text/css"
  }
}
